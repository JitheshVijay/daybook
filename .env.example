# AI connection for the chat. Copy this file to .env.local, fill in ONE option,
# and restart the dev server. Never prefix secrets with VITE_.

# Option 1 — OpenRouter: one key, many models. The model must support tool calling.
# openai/gpt-4.1-mini follows the logging rules most reliably; openai/gpt-4o-mini is cheaper.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Option 2 — OpenAI directly (used only when OPENROUTER_API_KEY is empty).
OPENAI_API_KEY=
OPENAI_MODEL=
# Point Option 2 at another OpenAI-compatible server, e.g. a local one:
# OPENAI_BASE_URL=http://localhost:11434/v1

# Where the database lives (default: data/daybook.db in this folder).
# DAYBOOK_DB=/path/to/daybook.db
